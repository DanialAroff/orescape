---
import './index.css';
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import { getCollection } from 'astro:content';

const entries = await getCollection('vault');

const grouped = entries.reduce((acc, entry) => {
	const parts = entry.id.split('/');
	const group = parts.length > 1 ? parts.slice(0, -1).join('/') : 'root';
	if (!acc[group]) acc[group] = [];
	acc[group].push(entry);
	return acc;
}, {} as Record<string, typeof entries>);
---

<StarlightPage frontmatter={{ title: 'Vault Notes' }}>
	<div class="total-docs">
		<p>Total documents</p>
		<p class="total-docs--count">
			{entries.length}
		</p>
	</div>
	{Object.entries(grouped).sort(([a], [b]) => a.localeCompare(b)).map(([group, items]) => (
		<section>
			<div id={group} class='group-name'>{group}</div>
			<ul>
				{items.map(item => (
					<li>
						<a href={`/vault/${item.id}`}>{item.id.split('/').pop()}</a>
					</li>
				))}
			</ul>
		</section>
	))}
</StarlightPage>
